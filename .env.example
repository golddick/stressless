APP_URL=http://localhost:3000
DATABASE_URL=<Neon pooled connection string>
DATABASE_URL_UNPOOLED=<Neon direct connection string, for migrations>
SESSION_PASSWORD=<32+ character secret>
DROPAPHI_API_KEY=<from DropAphi; leave empty in dev to log emails/SMS to the console>
DROPAPHI_BASE_URL=https://dropaphi.xyz
PAYSTACK_SECRET_KEY=<sk_...; leave empty in dev to use the built-in payment simulator>
PAYSTACK_PUBLIC_KEY=<pk_...>
SUPER_ADMIN_EMAIL=<your email, used by the seed>
VAPID_PUBLIC_KEY=<public key from pnpm exec web-push generate-vapid-keys>
VAPID_PRIVATE_KEY=<private key from pnpm exec web-push generate-vapid-keys>
VAPID_SUBJECT=mailto:admin@example.com
